{
  "name": "evergreen-ui",
  "version": "7.7.3",
  "description": "🌲 React UI Kit by Segment 🌲",
  "contributors": [
    "Jeroen Ransijn (https://jssr.design/)",
    "Roland Warmerdam (https://roland.codes)",
    "Matt Shwery (https://mattshwery.com)",
    "Colin Lohner (https://www.colinlohner.com)",
    "Allen Kleiner (http://allenk.me/)",
    "Chris Chuck (https://github.com/Chrischuck)",
    "Brandon Scott (https://brandonscott.me)"
  ],
  "keywords": [
    "evergreen",
    "segment",
    "ui",
    "react"
  ],
  "repository": "segmentio/evergreen",
  "license": "MIT",
  "main": "commonjs/index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "files": [
    "commonjs",
    "esm",
    "index.d.ts",
    "types"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./commonjs/index.js",
      "import": "./esm/index.js"
    }
  },
  "scripts": {
    "build": "yarn generate-icons && concurrently --names 'commonjs,esm,types' 'yarn build-commonjs' 'yarn build-esm' 'yarn build-types'",
    "build-codemods": "cd codemods && yarn build",
    "build-commonjs": "tsc --project tsconfig.commonjs.json",
    "build-esm": "BABEL_ENV=esm babel src --out-dir esm --ignore '**/stories','**/test','**/__tests__','**/types' --extensions '.js,.ts,.tsx'",
    "build-storybook": "build-storybook",
    "build-types": "tsc --project tsconfig.types.json",
    "build-umd": "rollup -c",
    "clean": "git clean -Xdf",
    "create-package": "./tools/create-package.js",
    "create-package:components": "./tools/create-package-components.js",
    "dev": "start-storybook -p 6006",
    "generate-icons": "./tools/generate-icons.js",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\" --cache",
    "prebuild": "yarn typecheck",
    "prepublishOnly": "rm -rf esm commonjs types && yarn build",
    "release": "np",
    "size": "size-limit",
    "test": "yarn lint && yarn tsd && yarn jest",
    "test:coverage": "yarn jest --coverage",
    "test:watch": "yarn jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@maestroqa/ui-box": "^5.9.1",
    "@segment/react-tiny-virtual-list": "^2.2.1",
    "@types/react-transition-group": "^4.4.0",
    "arrify": "^1.0.1",
    "downshift": "^5.2.0",
    "fuzzaldrin-plus": "^0.6.0",
    "humanize-plus": "^1.8.2",
    "lodash.debounce": "^4.0.8",
    "lodash.differencewith": "^4.5.0",
    "lodash.isempty": "^4.4.0",
    "lodash.merge": "^4.6.2",
    "lodash.omit": "^4.18.0",
    "lodash.uniqby": "^4.7.0",
    "prop-types": "^15.6.2",
    "react-fast-compare": "^3.2.0",
    "react-transition-group": "^4.4.1"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-is": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.1.2",
    "@babel/core": "^7.1.2",
    "@babel/plugin-proposal-class-properties": "^7.1.0",
    "@babel/plugin-proposal-private-methods": "^7.10.4",
    "@babel/plugin-transform-runtime": "^7.1.0",
    "@babel/preset-env": "^7.1.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.18.6",
    "@babel/register": "^7.0.0",
    "@blueprintjs/icons": "^3.31.0",
    "@faker-js/faker": "^10.5.0",
    "@reactions/component": "^2.0.2",
    "@rollup/plugin-babel": "^5.2.1",
    "@rollup/plugin-commonjs": "^15.1.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-replace": "^2.3.3",
    "@rollup/plugin-typescript": "^10.0.1",
    "@size-limit/file": "4.12.0",
    "@size-limit/webpack": "4.12.0",
    "@storybook/addon-essentials": "^6.0.21",
    "@storybook/addons": "^6.0.21",
    "@storybook/react": "^6.0.21",
    "@storybook/theming": "^6.0.21",
    "@testing-library/jest-dom": "^5.11.6",
    "@testing-library/react": "13.3.0",
    "@testing-library/user-event": "^13.1.9",
    "@types/fs-extra": "^9.0.13",
    "@types/fuzzaldrin-plus": "^0.6.2",
    "@types/humanize-plus": "1.8.0",
    "@types/jest": "27.4.0",
    "@types/lodash.debounce": "^4.0.6",
    "@types/lodash.differencewith": "^4.5.6",
    "@types/lodash.isempty": "^4.4.6",
    "@types/lodash.merge": "^4.6.6",
    "@types/lodash.uniqby": "^4.7.6",
    "@types/node": "^17.0.21",
    "@types/react-is": "17.0.3",
    "@types/testing-library__jest-dom": "5.14.3",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "^8.2.4",
    "babel-plugin-add-react-displayname": "^0.0.5",
    "camelcase": "^5.0.0",
    "concurrently": "^5.3.0",
    "eslint": "6.2.2",
    "eslint-config-prettier": "^6.11.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.20.6",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-sort-destructure-keys": "^1.3.5",
    "eslint-plugin-standard": "4.0.0",
    "file-loader": "^6.0.0",
    "fs-extra": "^7.0.0",
    "husky": "^4.0.10",
    "jest": "^26.4.2",
    "lint-staged": "^10.0.1",
    "np": "^8.0.4",
    "prettier": "2.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.2.0",
    "rollup": "^2.28.2",
    "rollup-plugin-terser": "^5.2.0",
    "sinon": "^8.1.0",
    "size-limit": "4.12.0",
    "starwars-names": "^1.6.0",
    "tsd": "^0.19.1",
    "typescript": "5.0.4",
    "url-loader": "^1.1.2",
    "webpack": "^4.47.0",
    "yarnhook": "^0.5.1"
  },
  "resolutions": {
    "**/react-syntax-highlighter/**/prismjs": "^1.30.0",
    "@types/react": "^18.3.0",
    "ansi-regex": "5.0.1",
    "**/react-dev-utils/immer": "^9.0.21",
    "**/react-dev-utils/loader-utils": "^2.0.4",
    "**/react-dev-utils/shell-quote": "^1.12.0",
    "**/@mdx-js/loader/loader-utils": "^2.0.4",
    "**/request/form-data": "^2.5.6",
    "**/terser-webpack-plugin/cacache/tar": "^7.5.22",
    "browserslist": "4.28.7",
    "postcss": "8.5.32",
    "autoprefixer": "10.4.27",
    "postcss-flexbugs-fixes": "5.0.2",
    "css-loader": "5.2.7",
    "minimatch": "3.1.3",
    "serialize-javascript": "7.1.3",
    "flatted": "3.4.4",
    "markdown-to-jsx": "7.4.0",
    "telejson": "6.0.8",
    "**/external-editor/tmp": "^0.2.7"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "!(codemods|esm|commonjs)/**/*.{js,ts,tsx}": [
      "yarn lint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./tools/test-setup-after-env"
    ],
    "transform": {
      "^.+/node_modules/@faker-js/faker/.+\\.js$": "<rootDir>/tools/babel-jest-faker.js",
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@faker-js/faker/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/codemods/",
      "<rootDir>/esm/",
      "<rootDir>/commonjs/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts,tsx}",
      "!**/*.stories.{js,jsx}",
      "!src/{constants,test,themes}/**",
      "!src/icons/generated/**"
    ]
  },
  "size-limit": [
    {
      "path": "commonjs/index.js",
      "limit": "305 KB"
    },
    {
      "path": "esm/index.js",
      "import": "{ Pane, Text, majorScale, SelectMenu, Menu, AddIcon, RemoveIcon }",
      "limit": "65 KB"
    }
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "post-merge": "yarnhook",
      "post-checkout": "yarnhook",
      "post-rewrite": "yarnhook"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
